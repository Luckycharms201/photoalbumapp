# Server
PORT=4000
NODE_ENV=development

# Where the React client runs (dev). Used for CORS + public link generation.
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Admin account (single user).
ADMIN_EMAIL=admin@example.com
# Preferred: store a bcrypt hash. Generate one with:
#   npm run create-admin -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Or (less secure) a plaintext password, hashed in memory on boot:
# ADMIN_PASSWORD=changeme123

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Upload limits
MAX_FILE_MB=25
MAX_FILES_PER_BATCH=100
GALLERY_PAGE_SIZE=24
